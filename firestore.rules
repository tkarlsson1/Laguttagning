rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == 'QLpq1rXHz2gjiipKFCnxEKk5xWx2';
    }

    function userSettingsPath(uid) {
      return /databases/$(database)/documents/userSettings/$(uid);
    }

    function currentUserSettings() {
      return get(userSettingsPath(request.auth.uid)).data;
    }

    function isTeamMember(teamId) {
      return isAdmin() || (
        signedIn() &&
        exists(userSettingsPath(request.auth.uid)) &&
        currentUserSettings().get('teams', []).hasAny([teamId])
      );
    }

    function ownSettingsUpdate(userId) {
      return signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastTeam', 'email', 'theme']) &&
        request.resource.data.get('teams', []) == resource.data.get('teams', []) &&
        request.resource.data.get('email', request.auth.token.email) == request.auth.token.email &&
        (!('theme' in request.resource.data) ||
          request.resource.data.theme in ['light', 'dark']) &&
        (!('lastTeam' in request.resource.data) ||
          request.resource.data.lastTeam == null ||
          resource.data.get('teams', []).hasAny([request.resource.data.lastTeam]));
    }

    function memberTeamUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['followedTeams', 'lagetUrl']) &&
        (!('followedTeams' in request.resource.data) ||
          request.resource.data.followedTeams is list) &&
        (!('lagetUrl' in request.resource.data) ||
          request.resource.data.lagetUrl is string);
    }

    match /userSettings/{userId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || ownSettingsUpdate(userId);
      allow delete: if isAdmin();
    }

    match /teams/{teamId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isTeamMember(teamId) && memberTeamUpdate());

      match /players/{playerId} {
        allow read, write: if isTeamMember(teamId);
      }

      match /matches/{matchId} {
        allow read: if signedIn();
        allow write: if isTeamMember(teamId);
      }

      match /lineups/{lineupId} {
        allow read, write: if isTeamMember(teamId);
      }

      match /customFormations/{formationId} {
        allow read, write: if isTeamMember(teamId);
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /updateLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
